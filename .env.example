# VREY Configuration

# Flask
FLASK_ENV=production
FLASK_DEBUG=False

# Server
PORT=6666

# Cache directory
VREY_CACHE_DIR=vrey_cache

# Optional: Anthropic API Key (for direct Claude integration)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Headroom compression settings
HEADROOM_ENABLED=true
HEADROOM_MODEL=kompress-base
HEADROOM_MAX_TOKENS=2000
